# Postgres — on Vercel/serverless prefer a pooler URL (e.g. Supabase
# “Transaction pooler”, port 6543). Direct :5432 can refuse or idle-timeout.
# Supabase: Settings → Database → connection string (this is what Drizzle uses).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Optional — only if you add @supabase/supabase-js (Storage, Realtime, browser
# queries). This repo does not read these; the DB is used server-side via
# DATABASE_URL only. Do not substitute these for DATABASE_URL.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical app URL (must match the host users open in the browser).
# Local: http://localhost:3000
# Production: https://your-project.vercel.app OR https://site24.com (not both mixed in AUTH_URL)
AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# OAuth client → Authorized redirect URIs (each host you use for login):
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-PROJECT.vercel.app/api/auth/callback/google
#   https://site24.com/api/auth/callback/google
# Error 400 redirect_uri_mismatch = this list is missing the exact URL Auth.js sends.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OpenRouter (optional – KI-Entwurfserweiterung) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modell-ID bei OpenRouter, z. B. openai/gpt-4o-mini, anthropic/claude-3.5-haiku
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional für OpenRouter-Rankings / Attribution
# OPENROUTER_HTTP_REFERER=https://deine-domain.de
# OPENROUTER_APP_TITLE=site24-marketing
